{
  "name": "tronsight-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build:go": "node build-go.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tronsight.sight",
    "productName": "Sight",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!bin/**"
    ],
    "extraResources": [
      {
        "from": "../configs/config.yaml",
        "to": "config.yaml"
      },
      {
        "from": "../web/templates",
        "to": "web/templates"
      },
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "../migrations",
        "to": "migrations"
      }
    ],
    "mac": {
      "target": [
        "zip",
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
